# ------------------------------------------------------------------
# Configuration — copiez ce fichier vers .env et remplissez les valeurs.
# .env est ignoré par git. Les clés SERVEUR ne sont jamais exposées au client ;
# les variables NEXT_PUBLIC_* sont publiques par conception (config Firebase web).
# ------------------------------------------------------------------

# --- Analyse de marché IA (serveur) ---
ANTHROPIC_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=

# --- Formulaire de contact (SendGrid, serveur) ---
SENDGRID_API_KEY=
# Adresse expéditrice — DOIT être vérifiée dans SendGrid.
CONTACT_FROM_EMAIL=
CONTACT_INBOX_EMAIL=

# --- PlexFlow (parc en temps réel, serveur) — en attente ---
PLEXFLOW_API_KEY=
PLEXFLOW_BASE_URL=
PLEXFLOW_WEBHOOK_SECRET=

# --- Firebase Auth (espace client) — config web PUBLIQUE (non secrète) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Accès au tableau de bord (liste blanche, séparées par des virgules).
NEXT_PUBLIC_ALLOWED_EMAILS=xavier@lavoiedigital.ca
# Accès à la zone admin (gestion des immeubles par client).
NEXT_PUBLIC_ADMIN_EMAILS=xavier@lavoiedigital.ca
